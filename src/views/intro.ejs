<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= conteudo.titulo %></title>
    <link rel="stylesheet" href="/css/intro.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="browser-bar">
                <div class="browser-dots">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
            </div>
            <h1 class="main-title"><%= conteudo.titulo %></h1>
        </header>

        <main class="content">
            <div class="ensino-section">
                <div class="image-container">
                    <% 
                        const imagens = conteudo.imagem ? conteudo.imagem.split('|') : [];
                        const temDuasImagens = imagens.length > 1;
                    %>
                    <% if (temDuasImagens) { %>
                        <!-- Duas imagens lado a lado -->
                        <div style="display: flex; gap: 20px; justify-content: center; align-items: center; width: 100%;">
                            <img src="/img/<%= imagens[0] %>" alt="<%= conteudo.titulo %>" class="ensino-image" style="max-width: 45%; height: auto;">
                            <img src="/img/<%= imagens[1] %>" alt="<%= conteudo.titulo %>" class="ensino-image" style="max-width: 45%; height: auto;">
                        </div>
                    <% } else { %>
                        <!-- Uma imagem única -->
                        <img src="/img/<%= conteudo.imagem %>" alt="<%= conteudo.titulo %>" class="ensino-image">
                    <% } %>
                </div>
            </div>
        </main>

        <footer class="footer">
            <button class="nav-btn" id="prevBtn" onclick="voltarPagina()" <% if (!temAnterior) { %>disabled<% } %>>
                <span>PÁGINA ANTERIOR</span>
            </button>
            
            <button class="nav-btn primary" id="nextBtn" onclick="proximaPagina()">
                <span>PRÓXIMA PÁGINA</span>
                <div class="btn-glow"></div>
            </button>
        </footer>
    </div>

    <!-- Canvas para confetes -->
    <canvas id="confetti-canvas"></canvas>

    <script>
        // Dados da página atual
        const paginaAtual = <%= ordem %>;
        const temProxima = <%= temProxima %>;
        const temAnterior = <%= temAnterior %>;
        const totalPaginas = <%= totalPaginas %>;

        function voltarPagina() {
            if (paginaAtual > 1) {
                const ordemAnterior = <%= ordem %> - 1;
                window.location.href = `/pagina/${ordemAnterior}`;
            } else {
                // Se estiver na página 1, volta para a introdução
                window.location.href = '/introducao';
            }
        }

        function proximaPagina() {
            const proximaOrdem = <%= ordem %> + 1;
            window.location.href = `/pagina/${proximaOrdem}`;
        }
    </script>
</body>
</html>