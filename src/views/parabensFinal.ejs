<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parabéns</title>
    <link rel="stylesheet" href="/css/parabens.css">
</head>
<body>

    <div class="container">
        <header class="header">
            <div class="browser-bar">
                <div class="browser-dots">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
            </div>
            <h1 class="main-title">PARABÉNS!</h1>
        </header>
        <main class="content">
            <div class="parabens-section">
                <p class="parabens-text">
                    VOCÊ TERMINOU TODOS OS NÍVEIS! VOCÊ MERECE UM CERTIFICADO, NÃO ACHA?
                </p>
            </div>
        </main>

        <footer class="footer">
            <button class="nav-btn" id="prevBtn">
                <span>PÁGINA ANTERIOR</span>
            </button>
        
            <button class="nav-btn special" id="certBtn">
                <span>CLIQUE AQUI PARA GERAR SEU CERTIFICADO</span>
                <div class="btn-glow"></div>
            </button>
        
            
            </button>
        </footer>
        
        </footer>
    </div>

    <canvas id="confetti-canvas"></canvas>

    <script>
        // Dispara confete ao carregar a página
        window.addEventListener('load', function() {
            // Toca áudio de parabéns
            const audioParabens = new Audio('/mp3/parabens.mp3');
            audioParabens.volume = 0.5;
            audioParabens.play().catch(err => {
                console.warn('Erro ao reproduzir áudio:', err);
            });

            disparaConfeteContinuo();
        });

        function disparaConfeteContinuo() {
            setInterval(() => {
                disparaConfete();
            }, 800); // Dispara confete a cada 800ms
        }

        function disparaConfete() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const particleCount = 50;

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: -10,
                    velocityX: (Math.random() - 0.5) * 8,
                    velocityY: Math.random() * 8 + 4,
                    color: ['#22D3EE', '#3B82F6', '#FACC15'][Math.floor(Math.random() * 3)],
                    size: Math.random() * 5 + 3
                });
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                particles.forEach((p, i) => {
                    p.x += p.velocityX;
                    p.y += p.velocityY;
                    p.velocityY += 0.1; // gravidade

                    ctx.fillStyle = p.color;
                    ctx.fillRect(p.x, p.y, p.size, p.size);

                    if (p.y > canvas.height) {
                        particles.splice(i, 1);
                    }
                });

                if (particles.length > 0) {
                    requestAnimationFrame(animate);
                }
            }

            animate();
        }
    </script>

    <script>
        document.getElementById('prevBtn').addEventListener('click', function() {
            // Volta para quiz 27
            window.location.href = '/quiz/27';
        });

        document.getElementById('certBtn').addEventListener('click', function() {
            // Redireciona direto para a página de certificado
            window.location.href = '/parabens/certificado';
        });
    </script>
</body>
</html>