<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parabéns!</title>
    <link rel="stylesheet" href="/css/parabens.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <div class="browser-bar">
                <div class="browser-dots">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
            </div>
            <h1 class="main-title">PARABÉNS!</h1>
        </header>

        <main class="content">
            <div class="parabens-section">
                <p class="parabens-text">
                    PARABÉNS!<br>
                    VOCÊ COMPLETOU O NÍVEL <%= nivel %>!<br>
                    JÁ ESTÁ FICANDO ESPERTO, HEIN?
                </p>
            </div>
        </main>

        <footer class="footer">
            <button class="nav-btn" id="prevBtn" onclick="voltarInicio()">
                <span>VOLTAR AO INÍCIO</span>
            </button>
            
            <button class="nav-btn primary" id="nextBtn" onclick="proximoNivel()">
                <span>PRÓXIMO NÍVEL</span>
                <div class="btn-glow"></div>
            </button>
        </footer>
    </div>

    <canvas id="confetti-canvas"></canvas>

    <script>
        const nivel = <%= nivel %>;

        function voltarInicio() {
            window.location.href = '/inicio';
        }

        function proximoNivel() {
            // Redireciona para próximo nível
            // Calcula a próxima ordem baseado no nível
            // Nível 1 (perguntas 1-3) → próxima ordem é 4 (intro/4)
            // Nível 2 (perguntas 4-6) → próxima ordem é 7 (intro/7)
            // Nível 3 (perguntas 7-9) → vai para certificado
            
            if (nivel >= 3) {
                // Completou tudo - vai para certificado
                window.location.href = '/parabens/certificado';
            } else {
                // Vai para a próxima intro
                const proximaOrdem = (nivel * 3) + 1;
                window.location.href = `/intro/${proximaOrdem}`;
            }
        }
    </script>
</body>
</html>