<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Parabéns!</title>
    <link rel="stylesheet" href="/css/parabens.css">
</head>
<body>

    <div class="container">
        <header class="header">
            <div class="browser-bar">
                <div class="browser-dots">
                    <div class="dot"></div>
                    <div class="dot"></div>
                    <div class="dot"></div>
                </div>
            </div>
            <h1 class="main-title">PARABÉNS!</h1>
        </header>

        <main class="content">
            <div class="parabens-section">
                <p class="parabens-text">
                    VOCÊ COMPLETOU O NÍVEL <%= nivel %>!<br>
                    JÁ ESTÁ FICANDO ESPERTO, HEIN?
                </p>
            </div>
        </main>

        <footer class="footer">
            <button class="nav-btn" id="prevBtn" onclick="voltarInicio()">
                <span>VOLTAR AO INÍCIO</span>
            </button>
            
            <button class="nav-btn primary" id="nextBtn" onclick="proximoNivel()">
                <span>PRÓXIMO NÍVEL</span>
                <div class="btn-glow"></div>
            </button>
        </footer>
    </div>

    <canvas id="confetti-canvas"></canvas>

    <script>
        // Dispara confete ao carregar a página
        window.addEventListener('load', function() {
            // Toca áudio de parabéns
            const audioParabens = new Audio('/mp3/parabens.mp3');
            audioParabens.volume = 0.5;
            audioParabens.play().catch(err => {
                console.warn('Erro ao reproduzir áudio:', err);
            });

            disparaConfeteContinuo();
        });

        function disparaConfeteContinuo() {
            setInterval(() => {
                disparaConfete();
            }, 800); // Dispara confete a cada 800ms
        }

        function disparaConfete() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const particleCount = 50;

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: -10,
                    velocityX: (Math.random() - 0.5) * 8,
                    velocityY: Math.random() * 8 + 4,
                    color: ['#22D3EE', '#3B82F6', '#FACC15'][Math.floor(Math.random() * 3)],
                    size: Math.random() * 5 + 3
                });
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                particles.forEach((p, i) => {
                    p.x += p.velocityX;
                    p.y += p.velocityY;
                    p.velocityY += 0.1; // gravidade

                    ctx.fillStyle = p.color;
                    ctx.fillRect(p.x, p.y, p.size, p.size);

                    if (p.y > canvas.height) {
                        particles.splice(i, 1);
                    }
                });

                if (particles.length > 0) {
                    requestAnimationFrame(animate);
                }
            }

            animate();
        }
    </script>

    <script>
        const nivel = <%= nivel %>;

        function voltarInicio() {
            window.location.href = '/inicio';
        }

        function proximoNivel() {
            // Estrutura de 27 páginas (9 por nível):
            // Nível 1: páginas 1-9 → próximo é página 10
            // Nível 2: páginas 10-18 → próximo é página 19
            // Nível 3: páginas 19-27 → vai para certificado
            
            if (nivel >= 3) {
                // Completou tudo - vai para certificado
                window.location.href = '/parabens/certificado';
            } else {
                // Vai para a primeira página do próximo nível
                const proximaOrdem = (nivel * 9) + 1;
                window.location.href = `/pagina/${proximaOrdem}`;
            }
        }
    </script>
</body>
</html>