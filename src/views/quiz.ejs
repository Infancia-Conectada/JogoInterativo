<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pergunta.titulo %></title>
    <link rel="stylesheet" href="/css/quiz.css">
    <link rel="stylesheet" href="/css/progresso.css">
</head>
<body>
    <!-- Barra de Progresso -->
    <div class="progress-bar-container">
        <div class="progress-bar" style="width: <%= (ordem / 27) * 100 %>%">
            <% if ((ordem / 27) * 100 >= 10) { %>
                <%= Math.round((ordem / 27) * 100) %>%
            <% } %>
        </div>
    </div>

    <div class="container">
        <header class="header">
            <div class="browser-bar">
                <div class="browser-dots">
                    <div class="dot orange"></div>
                    <div class="dot orange"></div>
                    <div class="dot orange"></div>
                </div>
            </div>
            <h1 class="main-title"><%= pergunta.titulo %></h1>
        </header>

        <main class="content <%= temErro ? 'shake' : '' %>">
            <div class="quiz-section">
                <% 
                    // Detecta se há imagens nas respostas
                    const temImagens = respostas.some(r => r.imagem);
                %>
                
                <% if (temImagens) { %>
                    <!-- Layout com imagens (grid 2x2) -->
                    <div class="alternatives-grid">
                        <% respostas.forEach((resposta, index) => { %>
                            <div class="alternative-box" data-id="<%= resposta.id %>" onclick="selecionarResposta(this)">
                                <div class="alternative-label"><%= String.fromCharCode(65 + index) %></div>
                                <% if (resposta.imagem) { %>
                                    <img src="<%= resposta.imagem %>" alt="" class="alternative-image" <% if (ordem === 16 || ordem === 18 || ordem === 26) { %>ondblclick="abrirModalImagem(event, '<%= resposta.imagem %>')"<% } %>>
                                    <% if (ordem === 16 || ordem === 18 || ordem === 26) { %>
                                        <div class="image-hint-small">CLIQUE DUAS VEZES PARA AUMENTAR</div>
                                    <% } %>
                                <% } %>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <!-- Layout com texto apenas (vertical) -->
                    <div class="alternatives-text-grid">
                        <% respostas.forEach((resposta, index) => { %>
                            <div class="alternative-text-box" data-id="<%= resposta.id %>" onclick="selecionarResposta(this)">
                                <div class="text-label"><%= String.fromCharCode(65 + index) %></div>
                                <div class="text-content">
                                    <%= resposta.titulo %>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </main>

        <footer class="footer">
            <button class="nav-btn" id="prevBtn" onclick="voltarPagina()">
                <span>PÁGINA ANTERIOR</span>
            </button>
            
            <button class="nav-btn primary" id="nextBtn" onclick="enviarResposta()">
                <span>PRÓXIMA PÁGINA</span>
                <div class="btn-glow"></div>
            </button>
        </footer>
    </div>

    <!-- Canvas para confetes -->
    <canvas id="confetti-canvas"></canvas>

    <!-- Modal fullscreen para imagens (Quiz 16) -->
    <div id="imagemModal" class="modal-imagem">
        <img id="imagemModalImg" src="" alt="Imagem ampliada" class="modal-imagem-content">
        <div class="modal-imagem-hint">ESC para fechar</div>
    </div>

    <script>
        const posicao = <%= ordem %>;
        let respostaSelecionada = null;

        // Ao carregar a página, limpa seleção e habilita o botão
        window.addEventListener('DOMContentLoaded', function() {
            // Reseta a seleção de resposta
            respostaSelecionada = null;
            
            // Limpa as seleções visuais
            document.querySelectorAll('.alternative-box, .alternative-text-box').forEach(el => {
                el.classList.remove('selected');
            });
            
            // Habilita o botão Próximo
            const nextBtn = document.getElementById('nextBtn');
            if (nextBtn) {
                nextBtn.disabled = false;
            }
            
            // Se houver erro (primeira tentativa errada), apenas exibe a mensagem
            // O temErro já está sendo renderizado no HTML via EJS
        });

        function selecionarResposta(elemento) {
            // Remove seleção anterior
            document.querySelectorAll('.alternative-box').forEach(box => {
                box.classList.remove('selected');
            });
            
            // Marca como selecionada
            elemento.classList.add('selected');
            respostaSelecionada = elemento.dataset.id;
        }

        // ========== FUNÇÕES DO MODAL (Quiz 16 - DUPLO CLIQUE) ==========
        function abrirModalImagem(event, imagemSrc) {
            event.stopPropagation();
            const modal = document.getElementById('imagemModal');
            const img = document.getElementById('imagemModalImg');
            img.src = imagemSrc;
            modal.classList.add('ativo');
        }

        function fecharModalImagem() {
            const modal = document.getElementById('imagemModal');
            modal.classList.remove('ativo');
        }

        // Fechar modal ao clicar fora da imagem
        document.addEventListener('DOMContentLoaded', function() {
            const modal = document.getElementById('imagemModal');
            if (modal) {
                modal.addEventListener('click', function(event) {
                    if (event.target === modal) {
                        fecharModalImagem();
                    }
                });
            }
        });

        // Fechar modal ao pressionar ESC
        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                fecharModalImagem();
            }
        });

        function voltarPagina() {
            const ordemAtual = <%= ordem %>;
            // Casos especiais
            if (ordemAtual === 1) {
                window.location.href = `/pagina/1`;
            } else if (ordemAtual === 7) {
                // Quiz 7 volta para página 6
                window.location.href = `/pagina/6`;
            } else if (ordemAtual === 16) {
                // Quiz 16 volta para página 15
                window.location.href = `/pagina/15`;
            } else if (ordemAtual === 17) {
                // Quiz 17 volta para quiz 16
                window.location.href = `/quiz/16`;
            } else if (ordemAtual === 18) {
                // Quiz 18 volta para quiz 17
                window.location.href = `/quiz/17`;
            } else if (ordemAtual === 25) {
                // Quiz 25 volta para página 24
                window.location.href = `/pagina/24`;
            } else if (ordemAtual === 26) {
                // Quiz 26 volta para quiz 25
                window.location.href = `/quiz/25`;
            } else if (ordemAtual === 27) {
                // Quiz 27 volta para quiz 26
                window.location.href = `/quiz/26`;
            } else {
                // Todos os outros quizzes voltam para o quiz anterior
                window.location.href = `/quiz/${ordemAtual - 1}`;
            }
        }

        function mostraErro(mensagem, isFinal = false) {
            // Aplica efeito de tremor na tela
            const content = document.querySelector('.content');
            if (content) {
                content.classList.add('shake');
            }
            
            // Cria um modal com o erro
            const errorModal = document.createElement('div');
            errorModal.style.cssText = `
                position: fixed;
                top: 50%;
                left: 50%;
                transform: translate(-50%, -50%);
                background: linear-gradient(135deg, rgba(239, 68, 68, 0.95), rgba(220, 38, 38, 0.95));
                border: 3px solid #EF4444;
                border-radius: 20px;
                padding: 40px;
                text-align: center;
                z-index: 9999;
                color: white;
                font-family: 'Mochiy Pop One', sans-serif;
                box-shadow: 0 0 50px rgba(239, 68, 68, 0.8);
                animation: slideDown 0.3s ease-out;
                max-width: 90%;
                width: 400px;
            `;
            
            errorModal.innerHTML = `
                <p style="font-size: 2em; margin-bottom: 20px; font-weight: bold;">❌ Eita!</p>
                <p style="font-size: 1.3em; margin-bottom: 15px;">${mensagem}</p>
                ${isFinal ? '<p style="font-size: 1.1em; color: #FCA5A5; margin-top: 20px;">Você será redirecionado...</p>' : ''}
            `;
            
            document.body.appendChild(errorModal);
            
            // Remove o tremor após a animação
            setTimeout(() => {
                if (content) {
                    content.classList.remove('shake');
                }
            }, 500);
            
            return errorModal;
        }

        function enviarResposta() {
            if (!respostaSelecionada) {
                alert('Por favor, selecione uma resposta!');
                return;
            }

            // Desabilita o botão para evitar múltiplos cliques
            document.getElementById('nextBtn').disabled = true;

            // Valida a resposta no servidor
            const payload = {
                idResposta: parseInt(respostaSelecionada)
            };

            console.log('Enviando validação:', payload);

            fetch(`/quiz/<%= ordem %>/validar`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(payload)
            })
            .then(response => response.json())
            .then(data => {
                console.log('Resposta do servidor:', data);
                const boxSelecionada = document.querySelector(`[data-id="${respostaSelecionada}"]`);
                
                if (data.correto) {
                    // RESPOSTA CORRETA - Mostra animação e confete
                    if (boxSelecionada) {
                        boxSelecionada.classList.add('correct');
                    }
                    disparaConfete();
                    
                    // Aguarda animação terminar antes de enviar
                    setTimeout(() => {
                        enviarRespostaAoServidor();
                    }, 1000);
                } else {
                    // RESPOSTA INCORRETA
                    console.log('Tentativas registradas:', data.tentativas);
                    if (data.tentativas >= 2) {
                        // Segunda tentativa errada - mostra erro com tremor
                        console.log('Redirecionando para /inicio');
                        mostraErro('Você errou pela segunda vez!<br>Voltando para o início...', true);
                        setTimeout(() => {
                            window.location.href = '/inicio';
                        }, 2500);
                    } else {
                        // Primeira tentativa errada - mostra erro com tremor
                        console.log('Mostrando erro de primeira tentativa');
                        mostraErro('Você só tem mais uma chance!<br>Se errar acabou!');
                        setTimeout(() => {
                            window.location.href = `/quiz/<%= ordem %>?erro=1`;
                        }, 2500);
                    }
                }
            })
            .catch(err => {
                console.error('Erro ao validar resposta:', err);
                document.getElementById('nextBtn').disabled = false;
            });
        }

        function enviarRespostaAoServidor() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = `/quiz/<%= ordem %>/submit`;

            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'idResposta';
            input.value = respostaSelecionada;

            form.appendChild(input);
            document.body.appendChild(form);
            form.submit();
        }

        function disparaConfete() {
            const canvas = document.getElementById('confetti-canvas');
            const ctx = canvas.getContext('2d');
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;

            const particles = [];
            const particleCount = 50;

            for (let i = 0; i < particleCount; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: -10,
                    velocityX: (Math.random() - 0.5) * 8,
                    velocityY: Math.random() * 8 + 4,
                    color: ['#22D3EE', '#3B82F6', '#FACC15'][Math.floor(Math.random() * 3)],
                    size: Math.random() * 5 + 3
                });
            }

            function animate() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                
                particles.forEach((p, i) => {
                    p.x += p.velocityX;
                    p.y += p.velocityY;
                    p.velocityY += 0.1; // gravidade

                    ctx.fillStyle = p.color;
                    ctx.fillRect(p.x, p.y, p.size, p.size);

                    if (p.y > canvas.height) {
                        particles.splice(i, 1);
                    }
                });

                if (particles.length > 0) {
                    requestAnimationFrame(animate);
                }
            }

            animate();
        }
    </script>
</body>
</html>