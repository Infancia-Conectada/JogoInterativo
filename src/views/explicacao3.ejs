<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= conteudo.titulo %></title>
    <link rel="stylesheet" href="/css/explicacao.css" />
    <link rel="stylesheet" href="/css/progresso.css" />
    <style>
        body {
            overflow: hidden;
            margin: 0;
            padding: 0;
        }
        
        .container {
            display: flex;
            flex-direction: column;
            height: 100vh;
            overflow: hidden;
        }

        main.content {
            flex: 1;
            overflow: hidden;
            display: flex;
            flex-direction: row;
            gap: 0px;
            padding-bottom: 120px;
        }

        .text-section {
            flex: 1;
            overflow: hidden;
            padding-right: 20px;
            max-width: none;
        }

        .text-section::-webkit-scrollbar {
            width: 8px;
        }

        .text-section::-webkit-scrollbar-track {
            background: transparent;
        }

        .text-section::-webkit-scrollbar-thumb {
            background: rgba(255, 107, 53, 0.5);
            border-radius: 4px;
        }

        .image-section {
            flex-shrink: 0;
            width: 40% !important;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            justify-content: flex-start;
            overflow: hidden;
            padding-top: 0;
            margin-top: 0;
            padding-left: 20px;
        }

        .image-section img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

        .video-hint {
            text-align: center;
            font-size: 1.1em;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: #ff6b35;
            margin-top: 15px;
            padding: 0 10px;
        }
        
        /* Botões de navegação no rodapé */
        .nav-buttons {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            position: fixed;
            bottom: 30px;
            left: 0;
            padding: 0 50px;
            z-index: 1000;
        }
        
        /* Estilos para passos numerados - SEM CAIXAS */
        .steps-container {
            display: flex;
            flex-direction: column;
            gap: 30px;
            margin-top: 20px;
        }
        
        .step {
            display: flex;
            gap: 15px;
            padding: 0;
            background: transparent;
            border-radius: 0;
            border-left: none;
            align-items: flex-start;
        }
        
        .step-number {
            flex-shrink: 0;
            width: 40px;
            height: 40px;
            background: #ff6b35;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 18px;
            margin-top: 2px;
        }
        
        .step-content {
            flex: 1;
            padding-top: 0px;
            line-height: 1.6;
            font-size: 16px;
            text-align: left;
        }
    </style>
</head>
<body>
    <!-- Barra de Progresso -->
    <div class="progress-bar-container">
        <div class="progress-bar" style="width: <%= (ordem / 27) * 100 %>%">
            <% if ((ordem / 27) * 100 >= 10) { %>
                <%= Math.round((ordem / 27) * 100) %>%
            <% } %>
        </div>
    </div>

    <div class="container">
        <header class="header">
            <div class="browser-bar">
                <div class="browser-dots">
                    <div class="dot orange"></div>
                    <div class="dot orange"></div>
                    <div class="dot orange"></div>
                </div>
            </div>
            <h1 class="main-title"><%= conteudo.titulo %></h1>
        </header>
 
        <main class="content" data-order="<%= ordem %>">
            <!-- TEXTO EXPLICATIVO -->
            <section class="rules-section" aria-labelledby="sec-explicacao">
                <div class="text-section">
                    <div class="rule-item" data-rule="1">
                        <div class="rule-text">
                            <h3 id="sec-explicacao">
                                <% 
                                    // Verifica se o texto contém quebras de linha (passos)
                                    const linhas = conteudo.texto.split('\n').filter(l => l.trim().length > 0);
                                    const temPassos = linhas.length > 1 && conteudo.nivel >= 2;
                                %>
                                
                                <% if (temPassos) { %>
                                    <!-- Renderiza como passos numerados -->
                                    <div class="steps-container">
                                        <% linhas.forEach((passo, index) => { %>
                                            <div class="step">
                                                <div class="step-number"><%= index + 1 %></div>
                                                <div class="step-content">
                                                    <%= passo.trim().replace(/^\d+\s*-\s*/, '') %>
                                                </div>
                                            </div>
                                        <% }); %>
                                    </div>
                                <% } else { %>
                                    <!-- Renderiza como texto simples (nível 1) -->
                                    <p><%= conteudo.texto %></p>
                                <% } %>
                            </h3>
                        </div>
                    </div>
                </div>
            </section>

            <!-- IMAGENS ILUSTRATIVAS À DIREITA -->
            <aside class="image-section" aria-label="Imagens ilustrativas">
                <% if (conteudo.imagem && conteudo.imagem.trim() !== '') { %>
                    <% 
                        const imagens = conteudo.imagem.split('|');
                        const temDuasImagens = imagens.length > 1;
                        
                        // Função para verificar se é vídeo
                        const isVideo = (arquivo) => /\.(mp4|webm|ogg)$/i.test(arquivo);
                        const getMediaPath = (arquivo) => arquivo.startsWith('/') ? arquivo : `/img/${arquivo}`;
                    %>
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: flex-start; width: 100%; height: 100%; margin: 0; padding: 0;">
                        <% if (temDuasImagens) { %>
                            <!-- Duas imagens lado a lado -->
                            <div style="display: flex; flex-direction: column; gap: 20px; justify-content: flex-start; align-items: center; width: 100%; padding: 0; margin: 0;">
                                <% if (isVideo(imagens[0])) { %>
                                    <video src="<%= getMediaPath(imagens[0]) %>" alt="Vídeo" class="image-item" controls autoplay loop muted style="max-width: 100%; height: auto;"></video>
                                <% } else { %>
                                    <img src="<%= getMediaPath(imagens[0]) %>" alt="Ilustração" class="image-item" />
                                <% } %>
                                <% if (isVideo(imagens[1])) { %>
                                    <video src="<%= getMediaPath(imagens[1]) %>" alt="Vídeo" class="image-item" controls autoplay loop muted style="max-width: 100%; height: auto;"></video>
                                <% } else { %>
                                    <img src="<%= getMediaPath(imagens[1]) %>" alt="Ilustração" class="image-item" />
                                <% } %>
                            </div>
                        <% } else { %>
                            <!-- Uma imagem/vídeo única -->
                            <% if (isVideo(conteudo.imagem)) { %>
                                <video src="<%= getMediaPath(conteudo.imagem) %>" alt="Vídeo" class="image-item" controls autoplay loop muted style="max-width: 100%; height: auto; margin: 0; padding: 0;"></video>
                                <% if (ordem === 24) { %>
                                    <p class="video-hint">CLIQUE NO VÍDEO PARA AUMENTAR</p>
                                <% } %>
                            <% } else { %>
                                <img src="<%= getMediaPath(conteudo.imagem) %>" alt="Ilustração" class="image-item" style="margin: 0; padding: 0;" />
                            <% } %>
                        <% } %>
                    </div>
                <% } %>
            </aside>
        </main>
 
        <footer class="footer">
            <div class="nav-buttons">
                <button class="learn-more-btn" id="prevPageBtn" type="button" onclick="voltarPagina()" <% if (!temAnterior) { %>disabled<% } %>>
                    <span>Página Anterior</span>
                    <div class="btn-glow"></div>
                </button>
 
                <button class="learn-more-btn" id="nextPageBtn" type="button" onclick="proximaPagina()">
                    <span>Próxima Página</span>
                    <div class="btn-glow"></div>
                </button>
            </div>
        </footer>
    </div>
 
    <script>
        const paginaAtual = <%= ordem %>;
        const temProxima = <%= temProxima %>;
        const temAnterior = <%= temAnterior %>;

        function voltarPagina() {
            if (paginaAtual > 1) {
                const ordemAnterior = <%= ordem %> - 1;
                window.location.href = `/pagina/${ordemAnterior}`;
            }
        }

        function proximaPagina() {
            const proximaOrdem = <%= ordem %> + 1;
            window.location.href = `/pagina/${proximaOrdem}`;
        }

        // Script especial para página 24 - Vídeo Friv em fullscreen com ciclo
        if (paginaAtual === 24) {
            document.addEventListener('DOMContentLoaded', function() {
                const video = document.querySelector('video');
                if (video) {
                    // Função para entrar em fullscreen
                    function enterFullscreen() {
                        if (video.requestFullscreen) {
                            video.requestFullscreen().catch(err => console.log('Erro ao entrar em fullscreen:', err));
                        } else if (video.webkitRequestFullscreen) {
                            video.webkitRequestFullscreen();
                        } else if (video.mozRequestFullScreen) {
                            video.mozRequestFullScreen();
                        } else if (video.msRequestFullscreen) {
                            video.msRequestFullscreen();
                        }
                    }

                    // Função para sair de fullscreen
                    function exitFullscreen() {
                        if (document.fullscreenElement) {
                            if (document.exitFullscreen) {
                                document.exitFullscreen();
                            } else if (document.webkitExitFullscreen) {
                                document.webkitExitFullscreen();
                            } else if (document.mozCancelFullScreen) {
                                document.mozCancelFullScreen();
                            } else if (document.msExitFullscreen) {
                                document.msExitFullscreen();
                            }
                        }
                    }

                    // Ao vídeo terminar, sai de fullscreen e aguarda 5 segundos
                    video.addEventListener('ended', function() {
                        exitFullscreen();
                        setTimeout(function() {
                            video.currentTime = 0;
                            video.play();
                            // Tenta entrar em fullscreen após 1 segundo de reprodução
                            setTimeout(enterFullscreen, 1000);
                        }, 5000);
                    });

                    // Clique no vídeo para entrar em fullscreen
                    video.addEventListener('click', function() {
                        enterFullscreen();
                    });

                    // Tenta entrar em fullscreen após 2 segundos (dá tempo para autoplay começar)
                    setTimeout(function() {
                        enterFullscreen();
                    }, 2000);
                }
            });
        }
    </script>
</body>
</html>
